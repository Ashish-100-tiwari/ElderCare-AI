# Copy to .env.local and fill in. All values are server-side only.
# Never add NEXT_PUBLIC_ to any of these — it would ship the secret to the browser.

# 127.0.0.1, not localhost — localhost may resolve to ::1, which the
# docker-compose port mapping does not listen on.
DATABASE_URL="postgresql://postgres:eldercare@127.0.0.1:5432/eldercare?schema=public"
OPENAI_API_KEY=""

# Optional. Empty => family alerts are recorded with webhookStatus SIMULATED.
FAMILY_WEBHOOK_URL=""

# Optional. Defaults to gpt-4o-mini.
# OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Voice. All optional — the browser's own speech APIs are tried first, and
# these only come into play as the fallback (or the upgrade, for output).
# Requires OPENAI_API_KEY; without it voice silently stays browser-only.
# ---------------------------------------------------------------------------

# Speech-to-text, used where the browser has no SpeechRecognition (Firefox).
# OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# Text-to-speech. Preferred over the OS voice — warmer, and worth the round trip.
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"

# Which voice Asha speaks with: coral, alloy, shimmer, sage, nova, ash, ballad…
# OPENAI_TTS_VOICE="coral"


# ---------------------------------------------------------------------------
# UI layer (/api/bff/*). All optional — with none of these set, the app runs
# entirely on in-memory demo data and needs no database and no API key.
# ---------------------------------------------------------------------------

# Set to 1 to make the UI read from the backend routes in this same app
# (requires DATABASE_URL and a seeded database).
# ELDERCARE_LIVE_API=1

# Which senior the UI shows. Defaults to senior-001, which the seed creates.
# DEMO_SENIOR_ID="senior-001"

# Only if the backend is deployed separately. Takes precedence over
# ELDERCARE_LIVE_API.
# BACKEND_API_URL="https://eldercare-api.example.com"
# BACKEND_API_KEY=""
# BACKEND_TIMEOUT_MS="10000"

# Optional real-time avatar provider. Without it the UI uses its built-in
# illustrated companion. The key is minted into a short-lived session token
# server-side and never reaches the browser.
# HEYGEN_API_KEY=""
# HEYGEN_AVATAR_ID=""
